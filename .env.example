# ---------------------------------------------------------------------------
# GPS_Tracer — environment configuration
#
# Copy to .env and fill in every CHANGE_ME value.
#
#   cp .env.example .env
#
# .env is gitignored. NEVER commit it, and never paste real secrets into this
# file. In Dokploy you do not need a .env file at all: set these same variables
# in the Dokploy UI (Compose → Environment), which keeps them out of Git
# entirely.
# ---------------------------------------------------------------------------

# --- Timezone ---------------------------------------------------------------
# Italy/EU. Affects how Traccar renders timestamps in the UI and reports.
# Note: position timestamps are always stored in UTC regardless of this.
TZ=Europe/Rome

# --- Branding (see docs/ARCHITECTURE.md § Branding) --------------------------
# Placeholders only. Do not invent the client's identity.
COMPANY_NAME="Company Name"
DASHBOARD_TITLE="Fleet Control"
COMPANY_LOGO="assets/logo-placeholder.svg"

# --- PostgreSQL -------------------------------------------------------------
# The database is NOT published to the host. It is reachable only by Traccar
# over the internal Docker network.
POSTGRES_DB=traccar
POSTGRES_USER=traccar
# Generate a strong one:  openssl rand -base64 24
# Must not contain $, ", ', \, or spaces — it is interpolated into an XML file.
POSTGRES_PASSWORD=CHANGE_ME

# --- Published ports --------------------------------------------------------
# The dashboard (human traffic). Put this behind HTTPS via Dokploy's proxy.
TRACCAR_WEB_PORT=8082
# H02 tracker protocol. This is what the physical tracker connects to, so it
# must be open to the public internet.
H02_PORT=5013

# --- Traccar ----------------------------------------------------------------
# error | warn | info | debug | trace
# Use info in production. debug is very noisy and will fill the log volume.
TRACCAR_LOG_LEVEL=info
# Java heap. Start at 1g; raise only if you actually see OOM in the logs.
JAVA_OPTS="-Xms256m -Xmx1024m -XX:MaxMetaspaceSize=256m"

# ONE-TIME BOOTSTRAP ONLY — set to true, deploy, run scripts/create-admin.sh,
# then set it straight back to false and redeploy.
#
# Traccar creates no users on a fresh install. With registration closed there is
# no way to create the first administrator, so the stack would start healthy
# with nobody able to log in. This flag is the supported way through that.
# Never leave it true on a reachable dashboard.
TRACCAR_ALLOW_REGISTRATION=false

# --- First administrator (used by scripts/create-admin.sh) -------------------
# Create a strong one:  openssl rand -base64 18
# No $ " ' \ or spaces.
ADMIN_NAME="Fleet Administrator"
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_PASSWORD=CHANGE_ME

# --- Data retention ---------------------------------------------------------
# Days of position history to keep. Traccar's own cleanup runs nightly.
# Italy/EU: location data tied to a named worker is personal data, so an
# unlimited identifiable retention is not the safe default. See
# docs/SECURITY.md § Data retention.
# 0 disables automatic cleanup (NOT recommended).
POSITION_RETENTION_DAYS=180

# --- Backups (see scripts/backup.sh) ----------------------------------------
# Where pg_dump files are written. Must NOT be inside the Git repository.
BACKUP_DIR=/var/backups/gpstracer
# Nightly backups kept before the oldest is pruned.
BACKUP_RETENTION_DAYS=14

# --- Tachograph service (docs/TACHO-SERVICE.md) ------------------------------
# Uploads driver cards and vehicle-unit files, normalises their activity, and
# calculates driving-time findings. Runs as two containers: an API and a worker.

# Shared secret between the dashboard and the tachograph API.
# THIS ONE IS MANDATORY. The API serves driver personal data; it refuses to start
# without a token rather than running open on the Docker network.
# Generate one:  openssl rand -base64 32
# No $ " ' \ or spaces.
TACHO_API_TOKEN=CHANGE_ME

# Loopback port for the API. It is deliberately not exposed publicly.
TACHO_API_PORT=8084

# Which browser origins may call the API. The dashboard's own origin only.
TACHO_ALLOWED_ORIGINS=http://127.0.0.1:8083

# Largest accepted upload, in bytes. A driver-card download is a few hundred
# kilobytes; the default of 8 MiB leaves generous room without inviting abuse.
TACHO_MAX_UPLOAD_BYTES=8388608

# Worker behaviour.
# How long to wait between polls when there is nothing to do.
TACHO_WORKER_POLL_SECONDS=3
# How long a claimed import may sit in 'processing' before another worker
# reclaims it. Must exceed the longest expected parse.
TACHO_WORKER_LEASE_MINUTES=15
# Attempts before an unparseable file is marked 'rejected' and stops being retried.
TACHO_WORKER_MAX_ATTEMPTS=3

# OPTIONAL. An external parser, for vehicle-unit downloads and GEN2/GEN2v2 files,
# which the built-in clean-room parser does not decode.
#
# The command reads a download on stdin and writes JSON on stdout. The intended
# partner is way-platform/tachograph-go (MIT) — see docs/LICENCES.md for why not
# the AGPL-licensed alternatives.
#
# Example (after installing tachograph-go into the worker image):
#   TACHO_EXTERNAL_PARSER=tachograph-go parse --format json
#
# Leave EMPTY to run the GEN1 driver-card parser only. Empty is the default and is
# a supported configuration: vehicle-unit files are then stored and reported as
# 'no activity records' rather than mis-parsed.
TACHO_EXTERNAL_PARSER=
