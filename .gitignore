# ---------------------------------------------------------------------------
# GPS_Tracer — secrets and local state. None of this may ever be committed.
# ---------------------------------------------------------------------------

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
secrets/

# Rendered at container start from environment variables. Contains the database
# password in clear text.
traccar/config/traccar.xml

# Local backups — must never live in the repository
backups/
*.sql
*.sql.gz
*.dump

# ...but the tachograph schema migrations are SOURCE, not dumps, and this is the
# one exception. `*.sql` above silently hid all four of them: tacho/tacho/db.py
# reads this directory at startup and raises if it holds no .sql files, so a fresh
# clone had no schema at all and could not start. Caught by auditing what the
# ignore rules were hiding, not by a test.
!tacho/migrations/*.sql
!scrap/migrations/*.sql

# Generated tool output (the archify working set): candidate/review JSON and a
# rendered HTML artifact, all reproducible. Contains absolute local paths.
.archify/

# Branding: keep placeholders in Git, keep the real client's assets out of it.
# See branding/README.md.
branding/assets/*
!branding/assets/.gitkeep
!branding/assets/logo-placeholder.svg

# Runtime / OS noise
.DS_Store
Thumbs.db
*.swp
*~

# Tachograph service (tacho/). Local Python state must never be committed.
# These are plain patterns on purpose: `tacho/**/__pycache__/` did not match at
# depth in practice, and a pattern that looks right but does not match is worse
# than no pattern at all.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Uploaded tachograph files and generated fixtures. These are driver personal
# data or stand in for it: keep both out of Git, always.
*.ddd
*.esm
!tacho/tests/**
tacho/objects/

# Local storage the tests and a development run may create.
tacho-data/
.local-tacho/

# Dashboard. dependency tree, build output, and the screenshots the browser
# acceptance test writes. node_modules is ~110 MB of other people's code and
# dist/ is generated by both `npm run build` and the image build; neither belongs
# in Git, and committing either makes every later diff unreadable.
node_modules/
dashboard/dist/
dashboard/shots/

# The rendered Traccar config if it ever lands on disk, and local env copies.
traccar/config/traccar.xml
.env
.env.*
!.env.example
